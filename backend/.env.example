# Copy thành .env và điền giá trị thật. KHÔNG commit file .env
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=WedMate
DB_USER=
DB_PASSWORD=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Google Gemini API (có hạn mức token theo ngân sách dự án)
GEMINI_API_KEY=
GEMINI_MODEL=
